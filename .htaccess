# Roll n' Brush Painting — Apache config (clean URLs, caching, compression)
Options -Indexes -MultiViews
RewriteEngine On

# Force HTTPS  (uncomment once SSL is live)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect /index.html and *.html to clean URLs (one URL per page)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(services|our-work)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve clean URLs from .html files
RewriteRule ^services/?$ services.html [L]
RewriteRule ^our-work/?$ our-work.html [L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
